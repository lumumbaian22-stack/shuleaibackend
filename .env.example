# ShuleAI production environment example
NODE_ENV=production
PUBLIC_API_BASE_URL=https://api.shuleai.live
FRONTEND_URL=https://shuleai.live
CORS_ORIGINS=https://shuleai.live,https://www.shuleai.live
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB

# Auth/security
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_REFRESH_EXPIRE=30d
SUPER_ADMIN_SECRET=replace-with-private-super-admin-secret
PAYMENT_VAULT_KEY=replace-with-32-byte-base64-or-strong-secret

# Durable storage. Recommended for production images/files.
FILE_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=shuleai
# Set true when you want boot to fail if Cloudinary is missing.
REQUIRE_OBJECT_STORAGE=false
MEDIA_KEEP_DB_COPY=false

# Monitoring
SENTRY_DSN=

# Realtime scale
REDIS_URL=

# Runtime schema repair should remain false in production after migrations are running reliably.
ALLOW_RUNTIME_SCHEMA_REPAIR=false
RUN_MIGRATIONS_ON_START=true
API_JSON_LIMIT=2mb
API_FORM_LIMIT=2mb
PAYMENT_PROVIDER_TIMEOUT_MS=15000
PAYMENT_PROVIDER_MAX_RESPONSE_BYTES=2097152
PAYMENT_RATE_LIMIT_MAX=60
PAYMENT_WEBHOOK_RATE_LIMIT_MAX=1200
PAYMENT_MAX_AMOUNT=100000000
TRUST_PROXY_HOPS=1

# Payment providers
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=
# Comma-separated current Safaricom callback IPs/CIDRs for production.
MPESA_CALLBACK_IP_ALLOWLIST=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
